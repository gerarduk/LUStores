# Test Environment Configuration
NODE_ENV=test
PORT=3001
HOST=localhost

# Use the same PostgreSQL database as development for consistency
DATABASE_URL=postgresql://postgres:password@localhost:5432/university_inventory

# Test configuration
TEST_TIMEOUT=30000
TEST_DB_RESET=true
TEST_DB_SEED=true

# Authentication & Security
JWT_SECRET=test-jwt-secret-key-for-testing
SESSION_SECRET=test-session-secret

# Logging
LOG_LEVEL=error
