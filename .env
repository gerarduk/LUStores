# Development Environment Variables
NODE_ENV=development
DEV_ADMIN_OVERRIDE=true
BYPASS_AUTH=true

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/university_inventory

# Session Security
SESSION_SECRET=dev-session-secret-for-local-development

# JWT Security
JWT_SECRET=dev-jwt-secret-for-local-development-very-long-key
JWT_EXPIRES_IN=7d

# Local Replit Auth Service (when using Docker)
REPL_ID=local-dev-repl
REPLIT_DOMAINS=localhost:5000
ISSUER_URL=http://localhost:3001/oidc
# COMPOSE_BAKE=true  # Temporarily disabled due to Windows path issuesDOMAIN=lustores.yourdomain.com
EMAIL=admin@yourdomain.com
HTTPS=true
FORCE_HTTPS=true
CERTBOT_EMAIL=admin@yourdomain.com